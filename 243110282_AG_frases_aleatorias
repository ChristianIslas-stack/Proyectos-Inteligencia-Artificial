e que surjan letras que quizás no estaban en los padres.\n","    \"\"\"\n","    lista_individuo = list(individuo)\n","    for i in range(len(lista_individuo)):\n","        if random.random() < TASA_MUTACION:\n","            lista_individuo[i] = random.choice(GENES)\n","    return \"\".join(lista_individuo)\n","\n","# --- BUCLE PRINCIPAL DE LA EVOLUCIÓN ---\n","\n","def simular_evolucion():\n","    # Paso 1: Crear la población inicial aleatoria\n","    poblacion = [generar_individuo(len(OBJETIVO)) for _ in range(POBLACION_TAMANIO)]\n","    generacion = 0\n","    encontrado = False\n","\n","    print(f\"Buscando la frase: '{OBJETIVO}'\\n\")\n","\n","    while not encontrado:\n","        # Paso 2: Evaluar y ordenar la población por su Fitness (de mejor a peor)\n","        poblacion = sorted(poblacion, key=lambda x: calcular_fitness(x), reverse=True)\n","        mejor_actual = poblacion[0]\n","\n","        # Mostrar progreso cada 10 generaciones o si llegamos al éxito\n","        if generacion % 10 == 0 or calcular_fitness(mejor_actual) == len(OBJETIVO):\n","            print(f\"Gen: {generacion} | Aptitud del mejor: {calcular_fitness(mejor_actual)}\")\n","            print(\"Top 5 individuos de la generación:\")\n","            for i in range(min(5, len(poblacion))):\n","                print(f\"  {i+1}. {poblacion[i]} (Aptitud: {calcular_fitness(poblacion[i])})\")\n","            print(\"-------------------------------------\")\n","\n","        # Condición de salida: Si el mejor individuo es igual al objetivo\n","        if calcular_fitness(mejor_actual) == len(OBJETIVO):\n","            encontrado = True\n","            break\n","\n","        # Paso 3: Selección de élite (el 10% mejor sobrevive directamente)\n","        nueva_generacion = []\n","        elite_cantidad = int(POBLACION_TAMANIO * 0.1)\n","        nueva_generacion.extend(poblacion[:elite_cantidad])\n","\n","        # Paso 4: Reproducción (Completar el resto de la población con hijos)\n","        for _ in range(POBLACION_TAMANIO - elite_cantidad):\n","            # Elegimos padres de la mitad superior (Selección natural simplificada)\n","            padre1 = random.choice(poblacion[:50])\n","            padre2 = random.choice(poblacion[:50])\n","\n","            # Cruzamos y mutamos al hijo\n","            hijo = cruzar(padre1, padre2)\n","            hijo = mutar(hijo)\n","            nueva_generacion.append(hijo)\n","\n","        poblacion = nueva_generacion\n","        generacion += 1\n","\n","# Ejecutar la simulación\n","simular_evolucion()"]},{"cell_type":"code","source":["import random\n","import string\n","\n","# 1. CONFIGURACIÓN\n","# Nuestra \"Bolsa de Palabras\" (Diccionario permitido)\n","BOLSA_PALABRAS = [\"HOLA\", \"CASA\", \"OSO\", \"MAMA\", \"PAPA\", \"MASA\", \"SOPA\", \"PISO\", \"LECHE\", \"PAN\", \"PERRO\", \"CACA\"]\n","# Definimos las constantes para claridad\n","VOCALES = \"AEIOU\"\n","CONSONANTES = \"BCDFGHJKLMNPQRSTVWXYZ\"\n","ESPACIO = \" \"\n","\n","# Línea de genes con mayor peso en vocales (aparecen 3 veces más que las consonantes)\n","GENES = (VOCALES * 3) + CONSONANTES + (ESPACIO * 2)\n","POBLACION_TAMANIO = 30\n","TASA_MUTACION = 0.05\n","LONGITUD_FRASE = 60  # Longitud máxima de los individuos\n","\n","def generar_individuo(longitud):\n","    return ''.join(random.choice(GENES) for _ in range(longitud))\n","\n","def calcular_fitness(individuo):\n","    \"\"\"\n","    NUEVA FUNCIÓN DE APTITUD:\n","    Mide qué tan \"coherente\" es la frase según la bolsa de palabras.\n","    \"\"\"\n","    puntos = 0\n","    # Dividimos el individuo en \"palabras\" usando los espacios\n","    palabras_en_individuo = individuo.split(\" \")\n","\n","    # Regla 1: Premiar si la palabra formada existe en la bolsa\n","    for palabra in palabras_en_individuo:\n","        if palabra in BOLSA_PALABRAS:\n","            puntos += 10  # Gran premio por palabra válida\n","            puntos += len(palabra) # Más puntos si la palabra es larga\n","\n","    # Regla 2: Premiar la existencia de espacios (evita que todo sea una sola masa)\n","    # Pero penalizar si hay demasiados espacios juntos (opcional)\n","    espacios = individuo.count(\" \")\n","    if 1 <= espacios <= 12:\n","        puntos += espacios\n","\n","    return puntos\n","\n","def cruzar(padre1, padre2):\n","    punto_corte = random.randint(0, LONGITUD_FRASE - 1)\n","    return padre1[:punto_corte] + padre2[punto_corte:]\n","\n","def mutar(individuo):\n","    lista_individuo = list(individuo)\n","    for i in range(len(lista_individuo)):\n","        if random.random() < TASA_MUTACION:\n","            lista_individuo[i] = random.choice(GENES)\n","    return \"\".join(lista_individuo)\n","\n","def simular_evolucion():\n","    poblacion = [generar_individuo(LONGITUD_FRASE) for _ in range(POBLACION_TAMANIO)]\n","    generacion = 0\n","\n","    print(f\"Evolucionando frases coherentes usando: {BOLSA_PALABRAS}\\n\")\n","\n","    # Ejecutamos por 800 generaciones para ver qué \"emerge\"\n","    for generacion in range(801):\n","        # Ordenar por fitness\n","        poblacion = sorted(poblacion, key=lambda x: calcular_fitness(x), reverse=True)\n","        mejor_actual = poblacion[0]\n","        fitness_max = calcular_fitness(mejor_actual)\n","\n","        if generacion % 20 == 0:\n","            print(f\"--- GENERACIÓN {generacion} ---\")\n","            print(f\"Mejor Fitness: {fitness_max}\")\n","            print(\"Top 3 frases que 'surgieron':\")\n","            for i in range(3):\n","                print(f\"  > {poblacion[i]}\")\n","            print(\"-\" * 30)\n","\n","        # Selección y Reproducción\n","        nueva_generacion = poblacion[:int(POBLACION_TAMANIO * 0.1)] # Élite\n","\n","        while len(nueva_generacion) < POBLACION_TAMANIO:\n","            p1 = random.choice(poblacion[:50])\n","            p2 = random.choice(poblacion[:50])\n","            hijo = mutar(cruzar(p1, p2))\n","            nueva_generacion.append(hijo)\n","\n","        poblacion = nueva_generacion\n","\n","simular_evolucion()"],"metadata":{"id":"lJZ74rT5MMV3","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1772899000935,"user_tz":360,"elapsed":282,"user":{"displayName":"CHRISTIAN ADBEL ISLAS REYES","userId":"14850796498485429167"}},"outputId":"c3f49778-6a59-487c-a978-e06d0978cfb2"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Evolucionando frases coherentes usando: ['HOLA', 'CASA', 'OSO', 'MAMA', 'PAPA', 'MASA', 'SOPA', 'PISO', 'LECHE', 'PAN', 'PERRO', 'CACA']\n","\n","--- GENERACIÓN 0 ---\n","Mejor Fitness: 8\n","Top 3 frases que 'surgieron':\n","  > TIRFJAIHKFRUDEUB A   OU ZBEFPEPTCUYIV ULINAWF  IUSAANCMCEUEK\n","  > IOEEWIEHDV CLCSGVZ XOCOR EOIXUULI OXUEYYJEEIJJGB V PIJ JJASD\n","  > FHLLIWOEOKIE OX GJTAVENUN AESUNV OO ZEXHUZMK  BNISPOLKUIDETQ\n","------------------------------\n","--- GENERACIÓN 20 ---\n","Mejor Fitness: 12\n","Top 3 frases que 'surgieron':\n","  > TIQ JAIHKFRUDIIB S   OUKLG QUUSLI OXOECYJEDIUJEB D P J UJAS \n","  > KEGIEYIHKFKIDEUB A   OURLG UU UL  OXUEYYJEDIJJEH V OIJ RJAS \n","  > UFWMUICYHOFFIAAU T    UKLK YU ULI OXEEYYJIDIJAOG V OIJ UAAS \n","------------------------------\n","--- GENERACIÓN 40 ---\n","Mejor Fitness: 12\n","Top 3 frases que 'surgieron':\n","  > TIQ JAIHKFRUDIIB S   OUKLG QUUSLI OXOECYJEDIUJEB D P J UJAS \n","  > KEGIEYIHKFKIDEUB A   OURLG UU UL  OXUEYYJEDIJJEH V OIJ RJAS \n","  > UFWMUICYHOFFIAAU T    UKLK YU ULI OXEEYYJIDIJAOG V OIJ UAAS \n","------------------------------\n","--- GENERACIÓN 60 ---\n","Mejor Fitness: 12\n","Top 3 frases que 'surgieron':\n","  > TIQ JAIHKFRUDIIB S   OUKLG QUUSLI OXOECYJEDIUJEB D P J UJAS \n","  > KEGIEYIHKFKIDEUB A   OURLG UU UL  OXUEYYJEDIJJEH V OIJ RJAS \n","  > UFWMUICYHOFFIAAU T    UKLK YU ULI OXEEYYJIDIJAOG V OIJ UAAS \n","------------------------------\n","--- GENERACIÓN 80 ---\n","Mejor Fitness: 12\n","Top 3 frases que 'surgieron':\n","  > TIQ JAIHKFRUDIIB S   OUKLG QUUSLI OX