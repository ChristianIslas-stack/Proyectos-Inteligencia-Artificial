RADA\n","# Bolsa ampliada con conectores para crear \"frases\"\n","# Bolsa simplificada con palabras más cortas y conectores clave (más fáciles de adivinar para el algoritmo)\n","BOLSA_PALABRAS = [\n","    # Sustantivos (Sujetos y Objetos limpios)\n","    \"MAMA\", \"PAPA\", \"NINO\", \"NINA\", \"GATO\", \"PERRO\", \"LOBO\", \"CASA\", \"LUNA\", \"AGUA\", \"SOPA\", \"CARNE\",\n","    # Verbos (Acciones claras de 4+ letras)\n","    \"COME\", \"MIRA\", \"SABE\", \"BEBE\", \"CORRE\", \"SALTA\", \"JUEGA\", \"LLORA\",\n","    # Adjetivos\n","    \"BUENO\", \"MALO\", \"LINDO\", \"SUAVE\"\n","]\n","\n","VOCALES = \"AEIOU \"\n","CONSONANTES = \"BCDFGHJKLMNPQRSTVWXYZ\" # Quité el espacio de las consonantes para no duplicar la probabilidad\n","ESPACIO = \" \"\n","\n","LONGITUD_FRASE = 18    # REDUCIDO\n","POBLACION_TAMANIO = 2000 # AUMENTADO\n","TASA_MUTACION = 0.05\n","\n","def generar_individuo_coherente(longitud):\n","    \"\"\"Crea un individuo siguiendo una lógica de Sílaba (Consonante + Vocal).\"\"\"\n","    frase = \"\"\n","    for i in range(longitud):\n","        # Cada 4-5 caracteres, forzamos o sugerimos un espacio\n","        if i > 0 and frase[-1] != ESPACIO and random.random() < 0.3:\n","            frase += ESPACIO\n","        else:\n","            # Si la anterior fue consonante, alta probabilidad de vocal\n","            if len(frase) > 0 and frase[-1] in CONSONANTES:\n","                frase += random.choice(VOCALES) if random.random() < 0.9 else random.choice(CONSONANTES)\n","            else:\n","                frase += random.choice(CONSONANTES + VOCALES)\n","    return frase[:longitud]\n","\n","def calcular_fitness(individuo):\n","    puntos = 0\n","    palabras_en_individuo = [p for p in individuo.split(ESPACIO) if p]\n","\n","    palabras_vistas = set() # Para rastrear palabras únicas\n","    palabras_validas_conteo = 0\n","\n","    for palabra in palabras_en_individuo:\n","        if palabra in BOLSA_PALABRAS:\n","            if palabra not in palabras_vistas:\n","                # REGLA 1: Premio por palabra nueva y válida\n","                puntos += 50 + (len(palabra) * 20) # AUMENTADO: Recompensamos mucho más encontrar palabras reales.\n","                palabras_vistas.add(palabra)\n","                palabras_validas_conteo += 1\n","            else:\n","                # REGLA 2: Penalización por repetición\n","                puntos -= 100 # CASTIGO DRÁSTICO: Antes era -10. Ahora odiará repetir palabras.\n","\n","        # REGLA 3: Seguimos premiando la estructura fonética básica (C+V)\n","        for i in range(len(palabra) - 1):\n","            if palabra[i] in CONSONANTES and palabra[i+1] in VOCALES:\n","                puntos += 1\n","\n","    # REGLA 4: Bono por \"Frase Completa\"\n","    # CAMBIO: Exigimos 3 palabras válidas en lugar de 2 para dar el bono.\n","    if palabras_validas_conteo >= 3:\n","        puntos += 300 # BONO MASIVO: Le damos un incentivo gigante por encadenar palabras.\n","\n","    # REGLA 5: Penalizar el exceso de \"ruido\" (letras sueltas que no son palabras)\n","    fragmentos_invalidos = len(palabras_en_individuo) - palabras_validas_conteo\n","    puntos -= (fragmentos_invalidos * 30) # CASTIGO SEVERO: Antes era -5. Ahora la basura de letras le restará muchísimos puntos, forzando los espacios limpios.\n","\n","    return puntos\n","\n","def mutar_coherente(individuo):\n","    \"\"\"Mutación que mantiene la lógica de los genes mejorados.\"\"\"\n","    lista = list(individuo)\n","    for i in range(len(lista)):\n","        if random.random() < TASA_MUTACION:\n","            # Puede mutar a espacio, vocal o consonante\n","            lista[i] = random.choice(VOCALES * 3 + CONSONANTES + ESPACIO * 2)\n","    return \"\".join(lista)\n","\n","def simular_evolucion():\n","    # Iniciamos con la lógica coherente\n","    poblacion = [generar_individuo_coherente(LONGITUD_FRASE) for _ in range(POBLACION_TAMANIO)]\n","\n","    for generacion in range(2001):\n","        poblacion = so