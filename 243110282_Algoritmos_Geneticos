 búsqueda (hiperparámetros / genes)"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mxtxTgMYZQeV","executionInfo":{"status":"ok","timestamp":1773207638310,"user_tz":360,"elapsed":9,"user":{"displayName":"CHRISTIAN ADBEL ISLAS REYES","userId":"14850796498485429167"}},"outputId":"c2fd7fdf-2168-4450-c5bc-e19adf415b3c"},"source":["capas_opciones      = [1, 2, 3]               # Número de bloques Conv+Pool\n","neuronas_opciones   = [64, 128]               # Neuronas en capa densa\n","kernels_opciones    = [16, 32, 64, 128]       # Filtros iniciales\n","batch_opciones      = [32, 64]                # Tamaño de batch\n","activacion_opciones = ['relu', 'tanh', 'elu'] # Función de activación\n","\n","total = (len(capas_opciones) * len(neuronas_opciones) *\n","         len(kernels_opciones) * len(batch_opciones) *\n","         len(activacion_opciones))\n","\n","print(f\"Total de individuos a entrenar: {total}\")\n","\n","generacion = 1\n","resultados = []"],"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Total de individuos a entrenar: 144\n"]}]},{"cell_type":"markdown","metadata":{"id":"axsKvk7CZQeV"},"source":["## 🧬 Celda 6 — Función de construcción del modelo"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EyLhdcxZZQeW","executionInfo":{"status":"ok","timestamp":1773207638326,"user_tz":360,"elapsed":17,"user":{"displayName":"CHRISTIAN ADBEL ISLAS REYES","userId":"14850796498485429167"}},"outputId":"2eb755de-f6be-42a7-a566-f2401eabda83"},"source":["def construir_modelo(n_capas, n_neuronas, n_kernels, activacion):\n","    model = tf.keras.Sequential()\n","    model.add(tf.keras.layers.InputLayer(input_shape=(28, 28, 1)))\n","\n","    for i in range(n_capas):\n","        filtros = n_kernels * (2 ** i)\n","        model.add(tf.keras.layers.Conv2D(filtros, (3, 3),\n","                                         activation=activacion,\n","                                         padding='same'))\n","        model.add(tf.keras.layers.MaxPooling2D(2, 2))\n","\n","    model.add(tf.keras.layers.Flatten())\n","    model.add(tf.keras.layers.Dense(n_neuronas, activation=activacion))\n","    model.add(tf.keras.layers.Dense(10, activation='softmax'))\n","\n","    model.compile(\n","        optimizer='adam',\n","        loss='sparse_categorical_crossentropy',\n","        metrics=['accuracy']\n","    )\n","    return model\n","\n","print(\"✅ Función definida\")"],"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Función definida\n"]}]},{"cell_type":"markdown","metadata":{"id":"e-dIyY5EZQeW"},"source":["## 🚀 Celda 7 — Búsqueda evolutiva: Generación 1"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zgO1StJIZQeW","executionInfo":{"status":"ok","timestamp":1773211176744,"user_tz":360,"elapsed":3538415,"user":{"displayName":"CHRISTIAN ADBEL ISLAS REYES","userId":"14850796498485429167"}},"outputId":"3b54a77c-bd29-4840-9315-9889c1138a4a"},"source":["inicio = datetime.now()\n","individuo_num = 0\n","\n","for n_capas in capas_opciones:\n","    for n_neuronas in neuronas_opciones:\n","        for n_kernels in kernels_opciones:\n","            for batch_size in batch_opciones:\n","                for activacion in activacion_opciones:\n","\n","                    individuo_num += 1\n","                    model = construir_modelo(n_capas, n_neuronas, n_kernels, activacion)\n","\n","                    history = model.fit(\n","                        x_train, y_train,\n","                        epochs=3,\n","                        batch_size=batch_size,\n","                        validation_data=(x_test, y_test),\n","                        verbose=0\n","                    )\n","\n","                    accuracy = history.history['val_accuracy'][-1]\n","                    acc_str  = str(round(accuracy * 10000)).zfill(4)\n","\n","                    nombre  = (f\"RNC_L{n_capas}_N{n_neuronas}_K{n_kernels}\"\n","                               f\"_BATCH{batch_size}_{activacion.upper()}_ACC{acc_str}\")\n","\n","                    # Guardar en Google Drive\n","                    carpeta = f\"{BASE_DIR}/generacion_{generacion}/{nombre}\"\n","                    os.makedirs(carpeta, exist_ok=True)\n","                    tfjs.converters.save_keras_model(model, carpeta)\n","\n","                    resultados.append({\n","                        'individuo': individuo_num,\n","                        'nombre': nombre,\n","                        'n_capas': n_capas,\n","                        'n_neuronas': n_neuronas,\n","                        'n_kernels': n_kernels,\n","                        'batch_size': batch_size,\n","                        'activacion': activacion,\n","                        'val_accuracy': round(accuracy, 4)\n","                    })\n","\n","                    print(f\"[{individuo_num:03d}/{total}] ✅ {nombre}\")\n","\n","print(f\"\\n✅ Generación 1 completada en {datetime.now() - inicio}\")"],"execution_count":7,"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/keras/src/layers/core/input_layer.py:27: UserWarning: Argument `input_shape` is deprecated. Use `shape` instead.\n","  warnings.warn(\n","WARNING:absl:You are saving your model as an HDF5 file via `model.save()` or `keras.saving.save_model(model)`. This file format is considered legacy. We recommend using instead the native Keras format, e.g. `model.save('my_model.keras')` or `keras.saving.save_model(model, 'my_model.keras')`. \n"]},{"output_type":"stream","name":"stdout","text":["failed to lookup keras version from the file,\n","    this is likely a weight only file\n","[001/144] ✅ RNC_L1_N64_K16_BATCH32_RELU_ACC9863\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:absl:You are saving your model as an HDF5 file via `model.save()` or `keras.saving.save_model(model)`. This file format is considered 